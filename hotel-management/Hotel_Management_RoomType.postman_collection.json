	"item": [
		{
			"name": "1. Create Room Type",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has success true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"});",
							"",
							"pm.test(\"Response contains room type data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.have.property('id');",
							"    pm.expect(jsonData.data).to.have.property('name');",
							"    pm.expect(jsonData.data).to.have.property('description');",
							"});",
							"",
							"// Save room type ID for later use",
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.collectionVariables.set(\"roomTypeId\", jsonData.data.id);",
							"    console.log(\"Saved roomTypeId: \" + jsonData.data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Standard Room\",\n  \"description\": \"Basic room with essential amenities including bed, bathroom, and TV\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/room-types",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"room-types"
					]
				},
				"description": "Create a new room type with name and description"
			},
			"response": []
		},
